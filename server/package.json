{
    "name": "brocode-server",
    "version": "1.0.0",
    "private": true,
    "engines": {
    "node": "20.x"
    },
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:migrate": "prisma migrate dev --name init",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "test": "vitest run --fileParallelism=false"
    },
    "dependencies": {
        "@prisma/client": "^5.10.2",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "jsonwebtoken": "^9.0.2",
        "socket.io": "^4.7.4",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^6.1.1",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.19.43",
        "@types/supertest": "^6.0.3",
        "prisma": "^5.10.2",
        "supertest": "^6.3.4",
        "tsx": "^4.7.1",
        "typescript": "5.9.3",
        "vitest": "^1.3.1"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
