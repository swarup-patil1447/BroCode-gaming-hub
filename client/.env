# Client API & WebSocket Configuration
# In development, relative '/api' leverages Vite's proxy (works seamlessly on localhost and LAN IP)
VITE_API_URL="/api"
VITE_SOCKET_URL=""

# In production (e.g. Netlify deployment connecting to external backend):
# VITE_API_URL="https://your-backend-api.com/api"
# VITE_SOCKET_URL="https://your-backend-api.com"
